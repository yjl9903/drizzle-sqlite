{
  "name": "drizzle-sqlite",
  "version": "0.0.0",
  "description": "Drizzle-orm node builtin sqlite support",
  "keywords": [
    "drizzle-orm",
    "sqlite"
  ],
  "homepage": "https://github.com/yjl9903/drizzle-sqlite#readme",
  "bugs": {
    "url": "https://github.com/yjl9903/drizzle-sqlite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjl9903/drizzle-sqlite.git"
  },
  "license": "MIT",
  "author": "XLor",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./migrator": {
      "types": "./dist/migrator.d.mts",
      "import": "./dist/migrator.mjs"
    }
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
